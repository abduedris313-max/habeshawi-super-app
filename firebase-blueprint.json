{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "harmony_notes": {
      "title": "Harmony Notes",
      "description": "Synced notes data across mini apps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "harmony_docs": {
      "title": "Harmony Docs",
      "description": "Rich text documents in Harmony Docs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "wordCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "harmony_writing": {
      "title": "Harmony Writing",
      "description": "Focus mode writing drafts & goals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "targetWordCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "harmony_music": {
      "title": "Harmony Music Playlists",
      "description": "Saved music playlists and favorites",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "playlistName": { "type": "string" },
        "tracks": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "playlistName"]
    },
    "harmony_ai_chats": {
      "title": "Harmony Docs AI Chats",
      "description": "AI analysis and document Q&A history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "docTitle": { "type": "string" },
        "messages": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId"]
    },
    "system_settings": {
      "title": "System Settings",
      "description": "User personalized system settings including theme, volume, and focus mode",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "isDarkMode": { "type": "boolean" },
        "volume": { "type": "number" },
        "brightness": { "type": "number" },
        "typewriterSounds": { "type": "boolean" },
        "hapticFeedback": { "type": "boolean" },
        "defaultViewMode": { "type": "string" },
        "accentColor": { "type": "string" },
        "focusMode": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "harmony_calendar": {
      "title": "Harmony Calendar Events",
      "description": "Calendar events supporting Gregorian, Hijri, and Ethiopian dates with Google Calendar sync",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "gregorianDate": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "allDay": { "type": "boolean" },
        "color": { "type": "string" },
        "category": { "type": "string" },
        "hijriDate": { "type": "string" },
        "ethiopianDate": { "type": "string" },
        "googleEventId": { "type": "string" },
        "syncedToGoogle": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "gregorianDate"]
    },
    "central_apps_catalog": {
      "title": "Central Apps Catalog",
      "description": "Published mini app packages in the Central Repository managed via App Store Admin Dashboard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "iconName": { "type": "string" },
        "iconCdnUrl": { "type": "string" },
        "colorGradient": { "type": "string" },
        "bgHex": { "type": "string" },
        "deployedUrl": { "type": "string" },
        "repoUrl": { "type": "string" },
        "version": { "type": "string" },
        "author": { "type": "string" },
        "size": { "type": "string" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "downloadsCount": { "type": "number" },
        "isSystemApp": { "type": "boolean" },
        "status": { "type": "string" },
        "badge": { "type": "string" },
        "permissions": { "type": "array" },
        "repositoryId": { "type": "string" },
        "releaseNotes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "version", "category"]
    },
    "admin_users": {
      "title": "Admin Console Users & Roles",
      "description": "Role-based profiles for App Store Developer Console and Admin Portal",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "organization": { "type": "string" },
        "developerHandle": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "harmony_finance_accounts": {
      "title": "Harmony Finance Accounts",
      "description": "Ledger accounts (checking, savings, cash, credit cards, investments)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "balance": { "type": "number" },
        "currency": { "type": "string" },
        "institution": { "type": "string" },
        "accountNumberMasked": { "type": "string" },
        "color": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "balance"]
    },
    "harmony_finance_transactions": {
      "title": "Harmony Finance Transactions",
      "description": "Financial income, expense, and transfer transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "accountId": { "type": "string" },
        "toAccountId": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "notes": { "type": "string" },
        "tags": { "type": "array" },
        "isRecurring": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "amount", "type", "date", "accountId"]
    },
    "harmony_finance_budgets": {
      "title": "Harmony Finance Budgets",
      "description": "Monthly category budget targets and threshold alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "monthlyLimit": { "type": "number" },
        "alertThreshold": { "type": "number" },
        "currency": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "category", "monthlyLimit"]
    },
    "harmony_finance_loans": {
      "title": "Harmony Finance Loans",
      "description": "Debt and loan schedules, balances, and payment records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "lenderOrBorrower": { "type": "string" },
        "originalPrincipal": { "type": "number" },
        "currentBalance": { "type": "number" },
        "interestRate": { "type": "number" },
        "tenureMonths": { "type": "number" },
        "monthlyEmi": { "type": "number" },
        "startDate": { "type": "string" },
        "nextDueDate": { "type": "string" },
        "totalPaidSoFar": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "paymentHistory": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "originalPrincipal", "currentBalance"]
    },
    "harmony_finance_subscriptions": {
      "title": "Harmony Finance Subscriptions",
      "description": "Recurring subscription expenses and billing alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "billingCycle": { "type": "string" },
        "nextBillingDate": { "type": "string" },
        "accountId": { "type": "string" },
        "status": { "type": "string" },
        "remindDaysBefore": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "amount", "billingCycle", "nextBillingDate"]
    }
  },
  "firestore": {
    "/admin_users/{userId}": {
      "schema": "admin_users",
      "description": "App Store developer console accounts and role assignments"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile information"
    },
    "/system_settings/{userId}": {
      "schema": "system_settings",
      "description": "User device settings including theme, volume, and focus mode"
    },
    "/central_apps_catalog/{appId}": {
      "schema": "central_apps_catalog",
      "description": "Mini apps published to the central repository and managed via Admin Dashboard"
    },
    "/harmony_notes/{noteId}": {
      "schema": "harmony_notes",
      "description": "User synchronized notes collection"
    },
    "/harmony_docs/{docId}": {
      "schema": "harmony_docs",
      "description": "User rich text documents collection"
    },
    "/harmony_writing/{draftId}": {
      "schema": "harmony_writing",
      "description": "User focus typewriter drafts collection"
    },
    "/harmony_music/{playlistId}": {
      "schema": "harmony_music",
      "description": "User music playlists collection"
    },
    "/harmony_ai_chats/{chatId}": {
      "schema": "harmony_ai_chats",
      "description": "User AI document conversation history"
    },
    "/harmony_calendar/{eventId}": {
      "schema": "harmony_calendar",
      "description": "User calendar events supporting Gregorian, Hijri, Ethiopian, and Google Calendar sync"
    },
    "/harmony_finance_accounts/{accountId}": {
      "schema": "harmony_finance_accounts",
      "description": "User general ledger accounts and liquidity balances"
    },
    "/harmony_finance_transactions/{transactionId}": {
      "schema": "harmony_finance_transactions",
      "description": "User financial transaction ledger entries"
    },
    "/harmony_finance_budgets/{budgetId}": {
      "schema": "harmony_finance_budgets",
      "description": "User monthly category budgeting limits"
    },
    "/harmony_finance_loans/{loanId}": {
      "schema": "harmony_finance_loans",
      "description": "User loan and debt amortization tracking"
    },
    "/harmony_finance_subscriptions/{subscriptionId}": {
      "schema": "harmony_finance_subscriptions",
      "description": "User recurring subscription plans and upcoming renewals"
    }
  }
}
